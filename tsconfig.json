{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"]
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/scripts", "demo"]
}
